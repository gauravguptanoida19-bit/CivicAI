# =============================================================
# CivicAI - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# =============================================================

# ----- APPLICATION -----
NODE_ENV=development
APP_NAME=CivicAI
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
ML_SERVICE_URL=http://localhost:8000

# ----- BACKEND SERVER -----
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# ----- FRONTEND -----
VITE_API_URL=http://localhost:3001
VITE_ML_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:3001
VITE_APP_NAME=CivicAI
VITE_DEMO_MODE=true
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ----- JWT -----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ----- DATABASE (PostgreSQL + PostGIS) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicai
DB_USER=civicai_user
DB_PASSWORD=your_db_password_here
DB_SSL=false
DATABASE_URL=postgresql://civicai_user:your_db_password_here@localhost:5432/civicai

# ----- REDIS -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://localhost:6379

# ----- ML SERVICE -----
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0
ML_DEMO_MODE=true
YOLO_MODEL_PATH=./models/civic_yolo.pt
CONFIDENCE_THRESHOLD=0.4

# ----- GENERATIVE AI (Optional - demo fallback if not provided) -----
# Provide either Gemini OR OpenAI key. Leave blank to use demo mode.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# ----- CHROMADB (Vector Store) -----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=civicai_issues

# ----- FILE UPLOAD -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime

# ----- EMAIL (Optional notifications) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@civicai.app

# ----- RATE LIMITING -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- LOGGING -----
LOG_LEVEL=info
LOG_FORMAT=json

# ----- DEMO MODE -----
# Set to true to use seeded demo data and simulated AI responses
DEMO_MODE=true
SEED_DEMO_DATA=true
